# Build output and local development resources.
/target/
/.cache/
**/*.rs.bk
/fixtures/generated/
/perf/results/
/spec/tools/
/spec/states/
/spec/results/
# Generated contract reports; source transcripts remain tracked.
/tests/results/
# Python benchmark caches and static evidence.
**/__pycache__/
# Storage conformance evidence, including r2-conformance.json (no archive source data).
/tests/results/storage/
# Generated adapter wire reports and local transport traces.
/tests/results/storage-wire/
# TLC diagnostic output; retained regression traces use spec/regressions/.
/spec/*.out
/spec/*_TTrace_*
# Archive prototype staging and comparison output.
/fixtures/generated/archive*/
/perf/results/archive-*.json
# Local archive coordination and interrupted publication staging.
/fixtures/generated/**/.writer.lock
/fixtures/generated/**/.staging-*

# Rebuildable archive capture projections.
/fixtures/generated/**/.projection/

# Rebuildable job scheduling databases inside generated test archives.
/fixtures/generated/**/.projection/jobs.sqlite3*

# Default recovery destinations and interrupted clean staging.
/*-restored-*/
/*-restore-*/
/*-bundle-*/

# GitHub discovery acceptance archives and interrupted mirror staging.
/fixtures/generated/github/
/fixtures/generated/**/.projection/github-staging/

# Generated LFS/wiki acceptance archives and native LFS staging.
/fixtures/generated/components/

# Authorized-plan acceptance archives, audit records, and restore destinations.
/fixtures/generated/plans/

# Status and sampled recovery acceptance archives.
/fixtures/generated/status/

# Private management state, security fixtures, and generated attack reports.
/.gitpickle-state/
/fixtures/generated/security/
/tests/results/security/

# Guided workflow fixtures, private setup state, and provider cache tests.
/fixtures/generated/workflow/
/recovered/

# Exported recovery cards and local compatibility reports.
/recovery-card*.json
/tests/results/compatibility/

# Machine inventory and isolated development preflight reports.
/tests/results/dev-env/

# Local MCP profiles, configuration previews, and acceptance output.
/.gitpickle-profiles.json
/mcp-config-preview*.json
/fixtures/generated/mcp/
/tests/results/mcp/

# Nonsecret provider preflight reports and disposable resource receipts.
/tests/results/resources/
# Cloudflare CLI account cache generated during resource preflight.
/.cloudflare/

# Bounded Git engine probes, cloned fixtures, and raw comparison reports.
/fixtures/generated/engine-spike/
/tests/results/git-engine/

# Portfolio recovery reports and compiled process network guards.
/tests/results/recovery/

# Generated Git HTTPS fixtures, TLS keys, clones, and compatibility reports.
/fixtures/generated/hosting/
/tests/results/hosting/

# Reproducible deployment bundles, image exports, and private runtime inputs.
/dist/
/deploy/*.env
/deploy/policy.json
# Local Git/R2 deployment reports, clones, and private TLS fixtures.
/tests/results/deployment/
/fixtures/generated/deployment/

# Reviewed installation plans and private generated deployment recipes.
/deploy/generated/
/fixtures/generated/setup/
/tests/results/setup/

# Optional terminal interface benchmark reports and PTY evidence.
/perf/results/tui/
/tests/results/tui/

# Validation source exports, paired runs, and interrupted gate staging.
/.cache/gates/
/tests/results/gates/
/perf/results/gates/

# Disposable publication workspaces and native protocol probe evidence.
/fixtures/generated/publication/
/tests/results/publication/

# Generated release review receipts and documentation verification reports.
/tests/results/release/

# Large-transfer fixtures share the disposable hosting test directory.
/fixtures/generated/hosting/**/large-*

# Hosted publication, retry receipts, and disposable push fixtures.
/tests/results/hosted/
/fixtures/generated/hosted/

# Integrated implementation acceptance reports; raw evidence stays outside the checkout.
/tests/results/implementation/

# Private usability recordings, notes, and copied evidence templates.
/tests/results/usability/

# Disposable B2 publication and recovery evidence.
/tests/results/storage-publication/

# Guided setup stages credentials; never track these runtime inputs.
**/runtime-inputs.json
